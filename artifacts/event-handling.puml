@startuml
title Обработка событий модели
|Контроллер|
start
:t = 0, очередь пуста, серверы свободны,\nвсе три указателя = 1, статистика обнулена;
|Игрок|
:Для каждого игрока k запланировать\nпервый запрос в момент Exp(λk) (ИЗ1);
|Контроллер|
repeat
  |Календарь|
  :next(): ближайшее событие, t = event.time;
  |Контроллер|
  if (Тип события?) then (SEARCH_REQUESTED)
    if (Создано меньше N запросов?) then (да)
      |Игрок|
      :Создать SearchRequest(k, n, t);
      |Статистика|
      :generated[k]++;
      |Календарь|
      :Запланировать следующий запрос\nигрока k в момент t + Exp(λk);
      |Очередь|
      :Искать свободную ячейку по кольцу\nс putPointer (Д1ОЗ1);
      if (Свободная ячейка найдена?) then (да)
        :Записать запрос в ячейку;
      else (нет)
        :Выбить запрос с min arrivalTime (Д1ОО3),\nна его место записать новый;
        |Статистика|
        :cancelled[игрок выбитого]++;
        |Очередь|
      endif
      :putPointer.moveAfter(ячейка);
    else (нет)
      :Событие отбрасывается;
    endif
  else (LOBBY_FORMED)
    |Сервер|
    :Освободить сервер, busyTime += τ;
    |Статистика|
    :processed[k]++, Тобсл и Твс запроса;
  endif
  |Диспетчер выбора|
  :Искать свободный сервер по кольцу\nс serverPointer (Д2П2);
  if (Сервер найден и очередь не пуста?) then (да)
    :serverPointer.moveAfter(сервер);
    |Очередь|
    :Взять запрос по кольцу с takePointer (Д2Б3),\nосвободить ячейку без сдвига;
    :takePointer.moveAfter(ячейка);
    |Статистика|
    :Тож = t − arrivalTime;
    |Сервер|
    :Начать сборку лобби;
    |Календарь|
    :Запланировать LOBBY_FORMED\nв момент t + τ, τ ~ Exp(μ) (ПЗ1);
  else (нет)
  endif
  |Контроллер|
  if (Пошаговый режим?) then (да)
    :Показать SystemState (ОД2);
  endif
repeat while (Календарь не пуст?) is (да) not (нет)
|Статистика|
:Таблицы по игрокам и серверам;\nГрафики по серии прогонов (ОР2);
stop
@enduml
