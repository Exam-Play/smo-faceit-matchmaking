@startuml
title Классы модели матчмейкинга
skinparam classAttributeIconSize 0
hide empty members

class SimulationController {
  + step()
  + runAuto(nRequests)
}
class EventCalendar {
  + schedule(event)
  + next(): Event
  + isEmpty(): boolean
}
class Event {
  - time
  - type: SEARCH_REQUESTED или LOBBY_FORMED
}

class Player <<ИБ, ИЗ1>> {
  - id
  - lambda
  + onSearchRequested(t)
}
class SearchRequest {
  - playerId
  - requestNo
  - arrivalTime
  - serviceStartTime
  - serviceEndTime
}
class EnqueueDispatcher {
  + enqueue(request)
}
class MatchmakingQueue <<Д1ОЗ1, Д1ОО3, Д2Б3>> {
  - cells[]
  - putPointer
  - takePointer
  + put(request): отменённый запрос или null
  + takeNext(): SearchRequest
  + isEmpty(): boolean
}
class AssignmentDispatcher <<Д2П2>> {
  - serverPointer
  + onQueueChanged()
  + onServerReleased(server)
}
class MatchmakingServer <<ПЗ1>> {
  - id
  - mu
  - current
  - busyTime
  + startLobbyBuilding(request, t)
  + onLobbyFormed(t)
  + isBusy(): boolean
}
class Statistics {
  + registerGenerated(request)
  + registerCancelled(request)
  + registerWaiting(request, wait)
  + registerProcessed(request)
}
class SystemState <<ОД2>> {
  - time
  - queueCells
  - putPointer
  - takePointer
  - serverPointer
  - servers
}
class ResultCharts <<ОР2>> {
  + buildCharts(results)
}

EventCalendar o-- Event
SimulationController *-- EventCalendar
SimulationController *-- Player
SimulationController *-- MatchmakingQueue
SimulationController *-- EnqueueDispatcher
SimulationController *-- AssignmentDispatcher
SimulationController *-- MatchmakingServer
SimulationController *-- Statistics
SimulationController ..> SystemState : создаёт на каждом шаге
SimulationController ..> ResultCharts : после серии прогонов

Player ..> SearchRequest : создаёт
Player --> EnqueueDispatcher : отдаёт запрос
EnqueueDispatcher --> MatchmakingQueue : put
AssignmentDispatcher --> MatchmakingQueue : takeNext
AssignmentDispatcher --> MatchmakingServer : startLobbyBuilding
MatchmakingServer --> AssignmentDispatcher : onServerReleased
EnqueueDispatcher --> AssignmentDispatcher : onQueueChanged
MatchmakingQueue o-- SearchRequest
MatchmakingServer o-- SearchRequest
Player --> EventCalendar
MatchmakingServer --> EventCalendar
@enduml
